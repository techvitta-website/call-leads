VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# NOTE: There is deliberately no VITE_GEMINI_API_KEY here.
# Anything prefixed VITE_ is compiled into the public JavaScript bundle and
# is readable by anyone who visits the site. The Gemini key is stored in
# Supabase Vault and used only by the `gemini-proxy` edge function.
# To rotate it, run as a manager or owner:
#   select public.rotate_gemini_key('YOUR_NEW_KEY');
